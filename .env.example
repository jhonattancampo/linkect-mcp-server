# Linkect MCP Server — Environment Variables
# Copy this file to .env and fill in your values

# Supabase project URL (find it in Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — bypasses RLS, keep this secret, never commit it
# Find it in Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
